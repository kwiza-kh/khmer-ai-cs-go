# ============================================
# Khmer AI Customer Service — environment config
# ============================================
# Copy to `.env` for local development (`cp .env.example .env`), or to
# `/opt/khmer-ai-cs/.env-go` on the production server, and edit the values.
# The backend loads `.env` via godotenv on startup; in production systemd
# supplies the same variables through EnvironmentFile=.env-go.
#
# Startup aborts on a missing or weak secret. config.Validate rejects a blank
# DATABASE_URL, a JWT_SECRET under 32 chars or the shipped default, and a
# blank PLATFORM_CREDENTIAL_KEY; security.NewSealer additionally requires that
# key to be base64 for exactly 32 random bytes.
#
# Deployment is bare-metal (nginx + systemd), not Docker — there is no
# docker-compose.yml. See deploy-khmer-ai-cs/ for the runbook.

# ---------- Data layer ----------
POSTGRES_DB=khmer_ai_cs
POSTGRES_USER=khmer
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=8080
GIN_MODE=release
# Public HTTPS backend origin, without /api/v1. Required for Telegram webhook
# auto-registration from the Platform page.
PUBLIC_API_URL=https://YOUR_BACKEND_DOMAIN
# Required: at least 32 random characters. Used to sign JWTs.
JWT_SECRET=
JWT_EXPIRE_HOUR=24
# Base64 encoded 32 random bytes. Encrypts saved channel credentials at rest.
PLATFORM_CREDENTIAL_KEY=
# Required on a fresh database (at least 12 characters). Also rotates the
# former default admin password on upgrade.
INITIAL_ADMIN_PASSWORD=
# CORS allow-list (comma-separated origins).
ALLOWED_ORIGINS=http://localhost:3000
# Required only when enabling Meta or WhatsApp webhooks.
META_VERIFY_TOKEN=
# Optional Meta OAuth one-click connection. The callback URL must exactly
# match the Facebook Login redirect URI configured in Meta for Developers.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URL=https://YOUR_BACKEND_DOMAIN/api/v1/platforms/meta/oauth/callback
META_OAUTH_FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN/platforms
META_GRAPH_API_VERSION=v24.0
# Optional override of the Facebook Login scope list (comma separated).
# Default: pages_show_list,pages_manage_metadata,pages_messaging,
#          instagram_basic,instagram_manage_messages
# The instagram_* scopes are only valid after enabling Instagram messaging in
# the Meta app (Dashboard → Messenger → Instagram Settings). Until then set
# META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging so
# the OAuth dialog does not fail on invalid scopes for Messenger connections.
META_OAUTH_SCOPES=
# Required only for WhatsApp Embedded Signup (Meta Business extension).
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# ---------- AI ----------
# Leave empty to run in MOCK mode (AI returns template replies; useful for
# demos / CI). Set to a real key to enable Gemini.
GEMINI_API_KEY=
# Optional: Gemini REST base URL (must include /v1beta). Set when the server
# egress IP is geo-blocked by Google ("User location is not supported"),
# pointing at a relay (e.g. a Cloudflare Worker) in a supported region.
#
# ONLY the studio transport reads this. With GEMINI_PROVIDER=vertex it is
# ignored, and that is one of the reasons to migrate: the platform endpoint is
# in-region (asia-southeast1), so the Cloudflare AI Gateway relay that exists
# purely to dodge the geo-block can be dropped — leave this empty on vertex,
# and set it again only if you ever roll back to studio.
# GEMINI_API_BASE=https://<relay-worker>.workers.dev/v1beta
#
# ---------- Provider: studio (default) or vertex ----------
# GEMINI_PROVIDER selects the transport for every Gemini call:
#   studio (unset / empty / anything unrecognised) — generativelanguage
#          .googleapis.com + x-goog-api-key. Today's production path.
#   vertex — {region}-aiplatform.googleapis.com + OAuth2 service account.
#          Different quota system (per-region QPS, not a spend window).
# The default is studio ON PURPOSE: switching transports is a deliberate
# operations act, so an unset or misspelled value can never reroute production.
# ⚠️ vertex without a usable service-account key is a STARTUP FAILURE, not a
# silent fallback to studio (the server exits; it never mixes the two). Deploy
# the SA key to /opt/khmer-ai-cs/vertex-sa.json, mode 600, owner
# khmerai:khmerai, and never commit it to the repository.
# GEMINI_PROVIDER=studio
# GCP project for the vertex resource path. Optional if the SA key carries
# project_id (it is read from the key); required when it does not.
# GEMINI_VERTEX_PROJECT=
# Region serving the models. Default asia-southeast1 — measured as the working
# target for this deployment; a wrong region is a 404 on every single call.
#
# This is the BOOT DEFAULT ONLY. The admin console (模型与区域) switches the
# serving region at runtime — stored in model_configs.vertex_region and applied
# without a restart — and a stored value overrides this variable on every start.
# So after a console switch, editing this line looks like it does nothing: clear
# model_configs.vertex_region to hand control back to this variable.
# GEMINI_VERTEX_REGION=asia-southeast1
# Path to the service-account JSON key (see the permission note above).
# GEMINI_VERTEX_SA_FILE=/opt/khmer-ai-cs/vertex-sa.json
# Optional: override the platform base URL (must include /v1, no trailing
# slash). Same purpose as GEMINI_API_BASE on the studio side: a relay for a
# geo-blocked egress, and a local stub for tests. Normally EMPTY — the region
# above already builds the right endpoint.
# GEMINI_VERTEX_API_BASE=
#
# Model names must be LOCKED VERSIONS, never a floating "-latest" alias:
# a floating alias moves with whatever upstream serves today, cannot be
# verified by a deploy, and the aliases used earlier in this project
# (gemini-flash-lite-latest) do not exist on the platform at all.
# A newer name is not "absent", it is REGION-SCOPED: gemini-3.8-flash exists on
# the platform but returns 200 only in global / us / eu — it is 404 in every
# single-region, INCLUDING this deployment's asia-southeast1 (measured
# 2026-09-25; full matrix in deploy-khmer-ai-cs/references/dev-guide.md §11.6).
# The platform also has NO lite tier (gemini-2.5-flash-lite and
# gemini-3.5-flash-lite 404 in every Asian region), so both the main and the
# auxiliary model use gemini-3.5-flash. Before pinning a new name here, look it
# up per region in the admin 「模型」 page (its region selector lists a chosen
# region's catalogue) or with `vertexprobe -models` — and treat that list as a
# CATALOGUE, not as a callability verdict (see §11.6).
GEMINI_MODEL=gemini-3.5-flash
# Auxiliary calls (rewrite / rerank / audit / document compile). Unset = reuse
# the serving model above, so leaving it blank is safe; set it only to pin a
# different locked version.
# GEMINI_FAST_MODEL=gemini-3.5-flash
# Output cap per reply. No effect on the average bill (output is billed as
# produced; measured mean ≈135 tokens) — it bounds the rare runaway answer that
# would eat the rolling spend window. The admin's model_configs.max_tokens wins
# once a row exists, so set it there too.
GEMINI_MAX_TOKENS=1024
# Explicit context caching (cachedContents). OFF by default because storage is
# billed per token-hour ($1/1M/hour on flash) while the cached-input discount is
# $0.27/1M: it only pays above ~3.7 requests/hour per cached prefix. Set to a
# TTL in seconds (e.g. 3600) to switch it on for burst traffic or a load test.
# The prefix must also clear the model minimum (GEMINI_CACHE_MIN_TOKENS=1024).
GEMINI_CACHE_TTL=0
# Cap on thinking tokens (thinkingConfig.thinkingBudget). Unset = the model's
# own default; 0 disables thinking (cheaper, faster, less accurate on hard
# questions). Thinking tokens are billed as output and now counted as such.
# GEMINI_THINKING_BUDGET=0
# Rolling 10-minute spend ceiling Google enforces ($10 Tier 1 / $50 Tier 2 /
# $200 Tier 3) and the fraction at which the local gate starts handing turns to
# a human instead of collecting a 429. RAISE THE LIMIT WHEN THE ACCOUNT
# UPGRADES, or the gate sheds turns Google would have accepted.
# GEMINI_SPEND_LIMIT_USD=10
# GEMINI_SPEND_GATE_RATIO=0.85
# Per-call ceiling (ms) for the RETRIEVAL_QUERY embedding, default 5000. This
# hop is on the reply path: without a budget it went straight into the retry
# helper, i.e. up to 3 attempts against the 60s client timeout, so a wobbling
# embed endpoint stalled a customer turn for ~3 minutes and then answered
# ungrounded anyway. On expiry the retrieval leg is dropped and the turn
# degrades to "answer without knowledge base" — the intended fallback. Raise it
# only if this host's embed latency makes 5s fire on healthy calls.
# GEMINI_EMBED_BUDGET_MS=5000
# Query-embedding keep-warm: a periodic tiny embedding that holds the pooled TLS
# connection to the model host open, so a customer's first grounding query does
# not pay the handshake. Required on the multi-region (global) endpoint, where a
# cold embedding costs ~11.2s against the budget above — the call is abandoned
# and the dense retrieval leg is lost on every cold turn (logged as "vector
# knowledge search failed; retaining lexical results"). Regional endpoints
# measure ~0.3s cold and do not need it. Must stay under Go's 90s idle timeout.
# 0 disables; default 45, the same interval as the Jev warmer.
# GEMINI_EMBED_KEEPWARM_SEC=45

# ---------- Jev routing / reply cache knobs (all optional, defaults in code) ----------
# Inbound routing thresholds (probabilities the Jev router must clear):
# hand the conversation to a human / answer without the knowledge base / drop
# junk with no reply at all. The junk bar sits highest on purpose — wrongly
# silencing a real customer is the router's worst failure mode.
# JEV_ROUTE_HANDOFF_MIN=0.80
# JEV_ROUTE_CHITCHAT_MIN=0.80
# JEV_ROUTE_JUNK_MIN=0.90
# Answer chit-chat (greetings, thanks) from a fixed template instead of a paid
# generation — Jev only routes small_talk when it is confident the message
# carries no request. 0 restores the previous path.
# JEV_CHITCHAT_CANNED=1
# Score position (0..2) above which a turn counts as urgent and its handoff
# request jumps to high priority.
# JEV_ROUTE_URGENT_MIN=1.5
# Per-call reply-path budgets (ms). Every Jev call must degrade rather than
# hold the turn: on expiry the caller falls back to its previous logic (fast
# model audit, legacy rewrite, fused retrieval order) and the call is reported
# to the health observer, so a merely SLOW Jev still pages. Defaults mirror the
# existing guard (3000) / route (4000) choices — above the warm spread to
# api.typesafe.ai (0.8-2.1s) with margin. Mind the tail: a COLD connection
# measured 0.64-4.24s on the production host, so a blown keep-warm pool makes
# these fire on every turn. That degrades instead of stalling (intended), but
# re-measure from the host before lowering any of them.
# JEV_ROUTE_BUDGET_MS=4000        # inbound routing
# JEV_GUARD_BUDGET_MS=3000        # reply audit
# JEV_TURN_BUDGET_MS=4000         # turn judgment (widget turn + background classifier)
# GEMINI_JUDGE_BUDGET_MS=10000    # fast-model FALLBACK verdict (runs only when Jev drops out)
# JEV_REWRITE_BUDGET_MS=3000      # follow-up query rewrite
# JEV_RERANK_BUDGET_MS=3000       # retrieval rerank
# JEV_NOTIFY_BUDGET_MS=2000       # new-message owner ping triage (background)
# Semantic reply cache (needs TYPESAFE-free Gemini key; disabled without one):
# REPLY_CACHE_ENABLED=false          # kill switch, default on
# REPLY_CACHE_MIN_SIM=0.92           # cosine similarity for a cache hit
# REPLY_CACHE_TTL_HOURS=72           # rows older than this expire
# REPLY_CACHE_MAX_PER_USER=500       # per-tenant cap (LRU by last hit)
# REPLY_CACHE_MIN_RUNES=12           # shorter queries never hit or store

# ---------- Frontend ----------
FRONTEND_PORT=3000
# What the BROWSER uses to reach the backend. For local docker this is the
# host-side published port. For prod, set to your real backend domain.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------- Cloudflare R2 (optional — used for file uploads in chat) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=khmer-ai-cs
R2_PUBLIC_URL=

# ---------- Voice replies (TTS) — requires R2 for audio hosting -------------
# When enabled and a customer sends a voice note, the AI also answers with a
# synthesized audio message. Off by default (voice replies surprise merchants).
# KEEP IT OFF: no preview TTS model exists on the platform in any tested region,
# and the model name below is a studio-only one.
TTS_ENABLED=false
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore

# ---------- Enterprise channels/auth (optional — blank = disabled) ----------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_INBOUND_DOMAINS=

VOICE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Google / OIDC sign-in ----------
SSO_ENABLED=false
SSO_PROVIDER=google
SSO_OIDC_ISSUER=
# OAuth client from Google Cloud Console (Web application type).
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
# Public callback URL registered in the console + where the browser returns.
SSO_REDIRECT_URL=https://YOUR_DOMAIN/api/v1/auth/google/callback
SSO_FRONTEND_URL=https://YOUR_DOMAIN/login
# Google may auto-create an account on first sign-in even when password
# registration is closed (ALLOW_REGISTRATION=false).
SSO_ALLOW_SIGNUP=true
# DANGER — deliberately NOT a triage knob. false (the default) makes the
# callback verify the id_token's RS256 signature against Google's published
# JWKS before trusting any claim. true skips that verification and trusts only
# the server's egress TLS to Google, which the verifying function's own comment
# names for what it is: account impersonation. Anyone able to interpose on that
# path (proxy, relay, compromised egress, hostile CA) can mint a login for ANY
# Google account, including one that already exists here.
#
# Set it only when the deployment genuinely cannot reach
# https://www.googleapis.com/oauth2/v3/certs, and treat the deployment as
# unauthenticated for Google sign-in while it is on. If JWKS fetches start
# failing, fix egress/proxy/DNS — do not reach for this.
SSO_SKIP_ID_TOKEN_VERIFY=false

# ---------- Telegram sign-in (OIDC) ----------
# Configured in @BotFather: open it as a MINI APP (not the chat), pick the bot,
# then Bot Settings -> Web Login, and switch to OpenID Connect Login.
#
# The bot must be a dedicated platform-level one. The Telegram bots in
# platform_configs belong to individual merchants (they are the customer-service
# channel) and must not be reused for sign-in. Note that migrations 054/056
# moved merchant NOTIFICATIONS onto the platform bot, so telegram_notify_settings
# no longer holds a bot token at all.
#
# ClientSecret is NOT the bot token — BotFather issues a separate secret.
TELEGRAM_LOGIN_ENABLED=false
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Must be registered verbatim under BotFather's "Redirect URIs"; Telegram
# refuses to redirect to an unregistered callback.
TELEGRAM_LOGIN_REDIRECT_URL=https://YOUR_DOMAIN/api/v1/auth/telegram/callback
# Where the browser lands after the exchange (the login page, not the API).
TELEGRAM_LOGIN_FRONTEND_URL=https://YOUR_DOMAIN/login
# Telegram sign-in may auto-provision an account even when ALLOW_REGISTRATION
# is false — same decoupling as SSO_ALLOW_SIGNUP.
TELEGRAM_LOGIN_ALLOW_SIGNUP=true
# Adds the `phone` scope: Telegram returns the user's VERIFIED phone number,
# which is worth capturing where SMS verification is expensive. Set false to
# request only openid+profile.
TELEGRAM_LOGIN_REQUEST_PHONE=true

# ---------- Platform Telegram bot (operator-owned) ----------
# A single bot owned by the operator, distinct from the merchant bots in
# platform_configs. It powers merchant notifications, the one-tap account
# linking behind Settings -> Telegram notifications, operational alerts, the
# admin console and the merchant support inbox.
#
# Treat the token like JWT_SECRET: it can message every linked merchant.
#
# Leave blank to disable all of it. Since migration 056 this is the ONLY
# notification path — there is no per-merchant bot fallback, and leaving it
# blank means merchants receive no Telegram notifications at all.
PLATFORM_TELEGRAM_BOT_TOKEN=
# Random string echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token.
# The webhook refuses to serve unauthenticated requests when this is unset.
PLATFORM_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user ids allowed to use the admin console.
# A linked account must ALSO still hold the platform_admin role, so demoting an
# operator revokes their console without editing this list.
PLATFORM_TELEGRAM_ADMINS=
# Where operational alerts are delivered. Defaults to the first admin id.
PLATFORM_TELEGRAM_ALERT_CHAT=
# @handle without the @, used to build the t.me account-linking deep link.
PLATFORM_TELEGRAM_BOT_USERNAME=
#
# Register the webhook once after deploying (see docs/DEVELOPMENT.md section 四).
# callback_query is REQUIRED — it carries the inline-button presses (handoff
# take-over/resolve, /unlink confirmation). Omit it and the buttons render and
# send fine but pressing them silently does nothing:
#   curl -X POST "https://api.telegram.org/bot${PLATFORM_TELEGRAM_BOT_TOKEN}/setWebhook" \
#     --data-urlencode "url=https://YOUR_BACKEND_DOMAIN/api/v1/webhook/telegram-platform" \
#     --data-urlencode "secret_token=${PLATFORM_TELEGRAM_WEBHOOK_SECRET}" \
#     --data-urlencode 'allowed_updates=["message","callback_query"]'

# --- RAG 调优（可选，均有默认值） ---
# 三腿融合的相对相似度门槛：低于 top_dense*ratio 或低于 floor 的 dense 命中会被丢弃
#RAG_SIMILARITY_FLOOR=0.35
#RAG_SIMILARITY_RATIO=0.75
# LLM 重排：候选最差分数低于 min 才进入重排；dense 领先分数 >= skip 时跳过重排
#RAG_RERANK_MIN=3.0
#RAG_RERANK_SKIP=0.70
# 摄入期 AI 编译：短于 min 或长于 max 的文档直接跳过（短文档不会走矛盾检测）
#RAG_COMPILE_MIN_RUNES=600
#RAG_COMPILE_MAX_RUNES=60000
# 单条来源注入 prompt 的字符上限（表格另有一档 2000）。默认 800 会把一篇 FAQ 里
# 同一节的后续条目切在窗口外：实测「MOQ 多少」在注入上下文里 MOQ 出现 0 次，
# 模型于是诚实地说"没有记录"（docs/DEVELOPMENT.md §十三）。生产已设为 1200。
# 代价：每轮约 +100 tokens/源，并把"第 5 个来源"换成"更长的前几个来源"（总预算不变）。
RAG_SOURCE_LIMIT_RUNES=1200
