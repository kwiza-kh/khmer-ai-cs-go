# ============================================
# Khmer AI Customer Service — environment config
# ============================================
# Copy to `.env` for local development (`cp .env.example .env`), or to
# `/opt/khmer-ai-cs/.env-go` on the production server, and edit the values.
# The backend loads `.env` via godotenv on startup; in production systemd
# supplies the same variables through EnvironmentFile=.env-go.
#
# Startup aborts on a missing or weak secret. config.Validate rejects a blank
# DATABASE_URL, a JWT_SECRET under 32 chars or the shipped default, and a
# blank PLATFORM_CREDENTIAL_KEY; security.NewSealer additionally requires that
# key to be base64 for exactly 32 random bytes.
#
# Deployment is bare-metal (nginx + systemd), not Docker — there is no
# docker-compose.yml. See deploy-khmer-ai-cs/ for the runbook.

# ---------- Data layer ----------
POSTGRES_DB=khmer_ai_cs
POSTGRES_USER=khmer
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---------- Backend ----------
BACKEND_PORT=8080
GIN_MODE=release
# Public HTTPS backend origin, without /api/v1. Required for Telegram webhook
# auto-registration from the Platform page.
PUBLIC_API_URL=https://YOUR_BACKEND_DOMAIN
# Required: at least 32 random characters. Used to sign JWTs.
JWT_SECRET=
JWT_EXPIRE_HOUR=24
# Base64 encoded 32 random bytes. Encrypts saved channel credentials at rest.
PLATFORM_CREDENTIAL_KEY=
# Required on a fresh database (at least 12 characters). Also rotates the
# former default admin password on upgrade.
INITIAL_ADMIN_PASSWORD=
# CORS allow-list (comma-separated origins).
ALLOWED_ORIGINS=http://localhost:3000
# Required only when enabling Meta or WhatsApp webhooks.
META_VERIFY_TOKEN=
# Optional Meta OAuth one-click connection. The callback URL must exactly
# match the Facebook Login redirect URI configured in Meta for Developers.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URL=https://YOUR_BACKEND_DOMAIN/api/v1/platforms/meta/oauth/callback
META_OAUTH_FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN/platforms
META_GRAPH_API_VERSION=v24.0
# Optional override of the Facebook Login scope list (comma separated).
# Default: pages_show_list,pages_manage_metadata,pages_messaging,
#          instagram_basic,instagram_manage_messages
# The instagram_* scopes are only valid after enabling Instagram messaging in
# the Meta app (Dashboard → Messenger → Instagram Settings). Until then set
# META_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging so
# the OAuth dialog does not fail on invalid scopes for Messenger connections.
META_OAUTH_SCOPES=
# Required only for WhatsApp Embedded Signup (Meta Business extension).
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# ---------- AI ----------
# Leave empty to run in MOCK mode (AI returns template replies; useful for
# demos / CI). Set to a real key to enable Gemini.
GEMINI_API_KEY=
# Optional: Gemini REST base URL (must include /v1beta). Set when the server
# egress IP is geo-blocked by Google ("User location is not supported"),
# pointing at a relay (e.g. a Cloudflare Worker) in a supported region.
# GEMINI_API_BASE=https://<relay-worker>.workers.dev/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2048
GEMINI_CACHE_TTL=3600

# ---------- Frontend ----------
FRONTEND_PORT=3000
# What the BROWSER uses to reach the backend. For local docker this is the
# host-side published port. For prod, set to your real backend domain.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------- Cloudflare R2 (optional — used for file uploads in chat) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=khmer-ai-cs
R2_PUBLIC_URL=

# ---------- Voice replies (TTS) — requires R2 for audio hosting -------------
# When enabled and a customer sends a voice note, the AI also answers with a
# synthesized audio message. Off by default (voice replies surprise merchants).
TTS_ENABLED=false
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_VOICE=Kore

# ---------- Enterprise channels/auth (optional — blank = disabled) ----------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_INBOUND_DOMAINS=

VOICE_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Google / OIDC sign-in ----------
SSO_ENABLED=false
SSO_PROVIDER=google
SSO_OIDC_ISSUER=
# OAuth client from Google Cloud Console (Web application type).
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
# Public callback URL registered in the console + where the browser returns.
SSO_REDIRECT_URL=https://YOUR_DOMAIN/api/v1/auth/google/callback
SSO_FRONTEND_URL=https://YOUR_DOMAIN/login
# Google may auto-create an account on first sign-in even when password
# registration is closed (ALLOW_REGISTRATION=false).
SSO_ALLOW_SIGNUP=true

# ---------- Telegram sign-in (OIDC) ----------
# Configured in @BotFather: open it as a MINI APP (not the chat), pick the bot,
# then Bot Settings -> Web Login, and switch to OpenID Connect Login.
#
# The bot must be a dedicated platform-level one. The Telegram bots in
# platform_configs belong to individual merchants (they are the customer-service
# channel) and must not be reused for sign-in. Note that migrations 054/056
# moved merchant NOTIFICATIONS onto the platform bot, so telegram_notify_settings
# no longer holds a bot token at all.
#
# ClientSecret is NOT the bot token — BotFather issues a separate secret.
TELEGRAM_LOGIN_ENABLED=false
TELEGRAM_LOGIN_CLIENT_ID=
TELEGRAM_LOGIN_CLIENT_SECRET=
# Must be registered verbatim under BotFather's "Redirect URIs"; Telegram
# refuses to redirect to an unregistered callback.
TELEGRAM_LOGIN_REDIRECT_URL=https://YOUR_DOMAIN/api/v1/auth/telegram/callback
# Where the browser lands after the exchange (the login page, not the API).
TELEGRAM_LOGIN_FRONTEND_URL=https://YOUR_DOMAIN/login
# Telegram sign-in may auto-provision an account even when ALLOW_REGISTRATION
# is false — same decoupling as SSO_ALLOW_SIGNUP.
TELEGRAM_LOGIN_ALLOW_SIGNUP=true
# Adds the `phone` scope: Telegram returns the user's VERIFIED phone number,
# which is worth capturing where SMS verification is expensive. Set false to
# request only openid+profile.
TELEGRAM_LOGIN_REQUEST_PHONE=true

# ---------- Platform Telegram bot (operator-owned) ----------
# A single bot owned by the operator, distinct from the merchant bots in
# platform_configs. It powers merchant notifications, the one-tap account
# linking behind Settings -> Telegram notifications, operational alerts, the
# admin console and the merchant support inbox.
#
# Treat the token like JWT_SECRET: it can message every linked merchant.
#
# Leave blank to disable all of it. Since migration 056 this is the ONLY
# notification path — there is no per-merchant bot fallback, and leaving it
# blank means merchants receive no Telegram notifications at all.
PLATFORM_TELEGRAM_BOT_TOKEN=
# Random string echoed back by Telegram in X-Telegram-Bot-Api-Secret-Token.
# The webhook refuses to serve unauthenticated requests when this is unset.
PLATFORM_TELEGRAM_WEBHOOK_SECRET=
# Comma-separated numeric Telegram user ids allowed to use the admin console.
# A linked account must ALSO still hold the platform_admin role, so demoting an
# operator revokes their console without editing this list.
PLATFORM_TELEGRAM_ADMINS=
# Where operational alerts are delivered. Defaults to the first admin id.
PLATFORM_TELEGRAM_ALERT_CHAT=
# @handle without the @, used to build the t.me account-linking deep link.
PLATFORM_TELEGRAM_BOT_USERNAME=
#
# Register the webhook once after deploying (see docs/DEVELOPMENT.md section 四).
# callback_query is REQUIRED — it carries the inline-button presses (handoff
# take-over/resolve, /unlink confirmation). Omit it and the buttons render and
# send fine but pressing them silently does nothing:
#   curl -X POST "https://api.telegram.org/bot${PLATFORM_TELEGRAM_BOT_TOKEN}/setWebhook" \
#     --data-urlencode "url=https://YOUR_BACKEND_DOMAIN/api/v1/webhook/telegram-platform" \
#     --data-urlencode "secret_token=${PLATFORM_TELEGRAM_WEBHOOK_SECRET}" \
#     --data-urlencode 'allowed_updates=["message","callback_query"]'

# --- RAG 调优（可选，均有默认值） ---
# 三腿融合的相对相似度门槛：低于 top_dense*ratio 或低于 floor 的 dense 命中会被丢弃
#RAG_SIMILARITY_FLOOR=0.35
#RAG_SIMILARITY_RATIO=0.75
# LLM 重排：候选最差分数低于 min 才进入重排；dense 领先分数 >= skip 时跳过重排
#RAG_RERANK_MIN=3.0
#RAG_RERANK_SKIP=0.70
# 摄入期 AI 编译：短于 min 或长于 max 的文档直接跳过（短文档不会走矛盾检测）
#RAG_COMPILE_MIN_RUNES=600
#RAG_COMPILE_MAX_RUNES=60000
